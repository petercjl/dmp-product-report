{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-chart period dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "meta",
    "periods",
    "comparisons",
    "metrics"
  ],
  "properties": {
    "contract": {
      "const": "period-metric-dashboard@1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subject",
        "asOf",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "periodNoun": {
          "type": "string"
        }
      }
    },
    "periods": {
      "type": "array",
      "minItems": 2,
      "maxItems": 52,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "start",
          "end",
          "days"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "days": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "current",
          "previous"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "previous": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "unit",
          "format",
          "comparison",
          "definition",
          "values"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "format": {
            "enum": [
              "integer",
              "decimal",
              "percent"
            ]
          },
          "comparison": {
            "enum": [
              "relative",
              "percentage_points"
            ]
          },
          "definition": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 52,
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "mode": {
      "enum": [
        "comparison",
        "trend",
        "combined"
      ]
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periods",
        "metrics"
      ],
      "properties": {
        "periods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 52,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "start",
              "end",
              "days"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string"
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "days": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "unit",
              "format",
              "comparison",
              "definition",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "integer",
                  "decimal",
                  "percent"
                ]
              },
              "comparison": {
                "enum": [
                  "relative",
                  "percentage_points"
                ]
              },
              "definition": {
                "type": "string"
              },
              "values": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 52,
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "trend"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "comparisons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "periods": {
            "minItems": 4,
            "maxItems": 4
          },
          "comparisons": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "combined"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "trend"
        ]
      }
    }
  ]
}